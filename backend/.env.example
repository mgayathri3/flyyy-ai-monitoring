# ============================================================
# FLYYY.AI Backend Configuration
# Copy this file to .env and fill in your values
# NEVER commit real credentials to the repository
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Format: postgresql://username:password@host:port/database_name

DATABASE_URL=postgresql://postgres:your_password@localhost:5432/flyyy_ai

# ============================================================
# AI PROVIDER CONFIGURATION
# ============================================================

# AI provider: "demo" for mock responses, "openai" for real API
AI_PROVIDER=demo

# OpenAI API key (required if AI_PROVIDER=openai)
# Get from: https://platform.openai.com/api-keys
AI_API_KEY=

# Model name
AI_MODEL=demo-support-v1

# OpenAI-compatible base URL (for other providers)
AI_BASE_URL=https://api.openai.com/v1

# ============================================================
# MONITORING CONFIGURATION
# ============================================================

# Enable/disable prompt monitoring
# true = store sanitized prompts + PII metadata
# false = don't store prompt content (privacy maximized)
PROMPT_MONITORING_ENABLED=true

# Retention period in days (how long to keep records)
RETENTION_DAYS=30

# ============================================================
# OBSERVABILITY CONFIGURATION
# ============================================================

# OpenTelemetry exporter endpoint (optional)
# For production: use Jaeger, Honeycomb, Grafana Loki, etc.
# Leave empty to store spans in database only
OTEL_ENDPOINT=

# ============================================================
# LOGGING (optional)
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================
# DEVELOPMENT/PRODUCTION
# ============================================================

# Environment: development, staging, production
ENVIRONMENT=development

# ============================================================
# SECURITY (Production only)
# ============================================================

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# Encryption key for sensitive fields (if implemented)
# ENCRYPTION_KEY=your-base64-encoded-key

# ============================================================
# NOTES
# ============================================================
# 1. Database Setup:
#    createdb -U postgres flyyy_ai
#    python init_db.py
#
# 2. For OpenAI integration:
#    - Set AI_PROVIDER=openai
#    - Set AI_API_KEY=sk-...
#    - Verify MODEL name matches available models
#
# 3. Production:
#    - Use strong database password
#    - Use managed database service (AWS RDS, etc.)
#    - Set ENVIRONMENT=production
#    - Configure OTEL_ENDPOINT for external observability
#
# ============================================================
