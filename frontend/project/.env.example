# FLYYY.AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real credentials to the repository.

# ──────────────────────────────────────────────
# Frontend (exposed to browser — NO secrets here)
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ──────────────────────────────────────────────
# Backend (edge function secrets — NOT exposed to browser)
# These are configured in Supabase as edge function secrets,
# NOT in the frontend .env file.
# ──────────────────────────────────────────────

# AI provider: "demo" for canned responses, or "openai" for live AI
AI_PROVIDER=demo

# OpenAI-compatible API key (leave empty for demo mode)
AI_API_KEY=

# Model name
AI_MODEL=demo-support-v1

# Base URL for OpenAI-compatible API
AI_BASE_URL=https://api.openai.com/v1

# Prompt monitoring: true = store sanitized prompts, false = store no prompt content
PROMPT_MONITORING_ENABLED=true

# Retention period in days (7, 30, 90, or custom)
RETENTION_DAYS=30

# OpenTelemetry exporter endpoint (optional — not used in demo, spans stored in DB)
OTEL_ENDPOINT=
